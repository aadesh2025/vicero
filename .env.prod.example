# ─────────────────────────────────────────────────────────────────────────────────────────────
# Vicero PRODUCTION env template  (Oracle single-box deploy — see docs/19-ORACLE-SINGLE-VPS-PLAN.md)
#
#   cp .env.prod.example .env          # on the VPS, in the repo root
#   edit every line marked [CHANGE]
#   cd infra && docker compose --env-file ../.env -f docker-compose.prod.yml up -d --build
#
# Never commit the real .env. Generate secrets with:  openssl rand -hex 32
# Every value here is a REPLACEMENT for the localhost value in .env.example.
# ─────────────────────────────────────────────────────────────────────────────────────────────

ENV=prod
LOG_LEVEL=info

# ── Secrets ─────────────────────────────────────────────────────────────────────────────────
# [CHANGE] JWT signing AND the key that encrypts saved provider keys. A NEW value cannot decrypt
# provider keys stored by an OLD database (start fresh, or re-enter them after moving data).
SECRET_KEY=
# [CHANGE] Compose interpolation reads this via --env-file. Do NOT leave "vicero".
POSTGRES_PASSWORD=
POSTGRES_USER=vicero
POSTGRES_DB=vicero

# ── Hostnames (two DNS A records -> the VPS public IP, set BEFORE the first `up`) ────────────
# [CHANGE]
DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# ── Public URLs (a wrong one here fails LATER, in front of a customer) ───────────────────────
# [CHANGE] Baked into the web image at BUILD time - rebuild `web` after changing either.
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_N8N_URL=https://n8n.yourdomain.com
# [CHANGE] Channel webhook URLs and n8n callbacks are built from this.
API_BASE_URL=https://api.yourdomain.com
# [CHANGE] Verify / reset / magic-link / invitation emails link here.
WEB_BASE_URL=https://app.yourdomain.com
# [CHANGE] Comma-separated. Dashboard + EVERY client site that embeds the widget (docs/16 s4).
CORS_ORIGINS=https://app.yourdomain.com
# [CHANGE] Google / Facebook login redirect base. Register
#   https://api.yourdomain.com/v1/auth/oauth/google/callback
#   https://api.yourdomain.com/v1/auth/oauth/facebook/callback
# in the Google Cloud / Meta developer consoles too, or social login fails.
OAUTH_REDIRECT_BASE=https://api.yourdomain.com
N8N_BASE_URL=http://n8n:5678

# ── Email (EMAIL_BACKEND=console only PRINTS emails to a log: nobody receives signup/reset links) ─
# [CHANGE]
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vicero <no-reply@yourdomain.com>

# ── LLM providers (cloud). Ollama is EMBEDDINGS ONLY on this box. ────────────────────────────
# [CHANGE] Copy from your local .env. All tenants share this key: free-tier rate limits apply.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Embeddings: keep EXACTLY as-is. Changing the model invalidates every stored vector. ──────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# compose already points api/worker at http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROBE_ENABLED=true

# ── Leave OFF: no docling / reranker service exists in the prod stack ────────────────────────
DOCLING_ENABLED=false
RERANK_ENABLED=false
LLM_FORCE_FAKE=false
CELERY_TASK_ALWAYS_EAGER=false

# ── Storage (single VPS: shared `uploads` volume; backed up nightly by the `backup` service) ──
STORAGE_BACKEND=local
UPLOAD_DIR=/app/var/uploads
BACKUP_RETENTION_DAYS=14

# ── n8n (run from a separate compose file, docs/16 s6). SAME secret on both sides. ───────────
# [CHANGE]
N8N_WEBHOOK_SIGNING_SECRET=
N8N_API_KEY=
N8N_REQUIRE_SIGNATURE_CHECK=true
# ── Automations (docs/26). Private n8n behind Vicero; `ops/n8n-setup.sh` creates the secrets below on the server ──
# [CHANGE] Generated by ops/n8n-setup.sh -- do not invent: AUTOMATION_REPORT_SECRET, N8N_DB_PASSWORD,
# N8N_ENCRYPTION_KEY (SAVE a copy in your password manager), N8N_EDITOR_GATE_USER, N8N_EDITOR_GATE_HASH.
AUTOMATION_REPORT_SECRET=
N8N_DOMAIN=viceroai-n8n.duckdns.org
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_EDITOR_GATE_USER=
N8N_EDITOR_GATE_HASH=
N8N_REQUIRE_REGISTERED_AUTOMATION=true
AUTOMATION_PULL_ENABLED=true
N8N_BASIC_AUTH_USER=admin
# [CHANGE] Do NOT leave "vicero".
N8N_BASIC_AUTH_PASSWORD=

# ── Memory ceilings for a 12 GB Oracle A1 box (docs/19 s3). Compose reads these via --env-file ─
POSTGRES_MEM_LIMIT=2g
POSTGRES_MEM_RESERVATION=1g
REDIS_MEM_LIMIT=512m
REDIS_MEM_RESERVATION=128m
MIGRATE_MEM_LIMIT=1g
API_MEM_LIMIT=1536m
WORKER_MEM_LIMIT=2g
BEAT_MEM_LIMIT=256m
WEB_MEM_LIMIT=1g
CADDY_MEM_LIMIT=256m
OLLAMA_MEM_LIMIT=2g
BACKUP_MEM_LIMIT=512m

# ── Optional ─────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_VERIFY_TOKEN=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v23.0
META_APP_LIVE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
