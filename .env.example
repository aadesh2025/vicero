# Vicero environment. Copy to .env and fill in. See docs/ENV.md for the full reference.
# Lines marked [HUMAN] can only be created by you; leave blank to run with that feature stubbed.
#
# FORMATTING RULE — a comment never shares a line with a blank value.
# `KEY=            # note` does NOT parse to an empty string: the spaces after `=` are consumed
# as the separator, so the `#` starts the value and the comment text becomes the value. That
# shipped a placeholder to Google as a real API key once (ADR-044). `KEY=value  # note` is fine,
# but keep new placeholders in the documented shape below and the trap can't come back.

# ── Core ─────────────────────────────────────────────────────────────────────
ENV=dev                                   # dev | test | prod
LOG_LEVEL=info
# [HUMAN] JWT signing + key encryption
SECRET_KEY=change-me-generate-a-long-random-string
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Production deploy (docker-compose.prod.yml + Caddy TLS) ───────────────────
# [HUMAN] dashboard hostname (Caddy auto-TLS)
DOMAIN=app.example.com
# [HUMAN] API hostname (Caddy auto-TLS)
API_DOMAIN=api.example.com
# [HUMAN] Let's Encrypt contact email
ACME_EMAIL=you@example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # prod: https://$API_DOMAIN (baked into the web build)
NEXT_PUBLIC_N8N_URL=http://localhost:5678        # prod: https://n8n.<your-domain> (baked into the web build; the "Open n8n" link)
BACKUP_RETENTION_DAYS=14                   # nightly pg_dump retention (prod backup service)

# ── Datastores (compose sets these to in-network hosts automatically) ────────
POSTGRES_USER=vicero
# [HUMAN] Choose a strong password — "vicero" is the first thing anyone tries. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(30))"
# and use the SAME value in DATABASE_URL below. Compose refuses to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=vicero
DATABASE_URL=postgresql+asyncpg://vicero:change-me-to-a-long-random-value@127.0.0.1:5432/vicero
# 127.0.0.1, not localhost: the dev containers publish on IPv4 loopback only, and localhost tries IPv6 first.
# [HUMAN] Password for the dev Redis (compose refuses to start without it). Generate one the same way as
# POSTGRES_PASSWORD above and use the SAME value inside REDIS_URL.
REDIS_PASSWORD=change-me-to-a-long-random-value
REDIS_URL=redis://:change-me-to-a-long-random-value@127.0.0.1:6379/0
# The bundled Postgres' host port is `POSTGRES_HOST_PORT` (default 5432). Same compose-only
# caveat as N8N_HOST_PORT below: interpolation variables come from the shell or `infra/.env`,
# never from this file. If another project already holds 5432:
#     cd infra && POSTGRES_HOST_PORT=5433 docker compose up -d postgres
# then set DATABASE_URL=...@localhost:5433/vicero here. Do NOT instead point Vicero at the
# Postgres that is already on 5432 — `alembic upgrade head` would migrate someone else's database.

# ── LLM providers (free-first). Unset → provider stubbed + warned. ───────────
# [HUMAN] default provider (free signup)
GROQ_API_KEY=
# [HUMAN] Google Gemini free tier
GEMINI_API_KEY=
# [HUMAN] free models via OpenRouter
OPENROUTER_API_KEY=
# [HUMAN] paid
OPENAI_API_KEY=
# [HUMAN] paid
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434    # local models + embeddings (bundled)
# Private/LAN hosts a *tenant-set* provider endpoint (Settings -> Provider keys -> Custom endpoint,
# or an Ollama/Mistral/... URL override) may point at. Empty = tenants can only reach public
# endpoints. Comma-separated exact hostnames or IPs, e.g. host.docker.internal,10.0.0.5.
# Operator-only: never expose this to tenants. Does not affect OLLAMA_BASE_URL above.
PROVIDER_PRIVATE_HOSTS=
# `openai` and `gemini` are accepted here and then routed to Ollama anyway - no adapter for
# either was ever written. Startup warns if you set one, because there is otherwise no symptom.
EMBEDDING_PROVIDER=ollama
# 768 dimensions, which is what the `chunks.embedding` column is. A model with a different
# dimension needs a migration, not just this line.
EMBEDDING_MODEL=nomic-embed-text
# One HTTP GET at startup: does the embedding endpoint answer, and does it have the model pulled?
# It exists because prod pointed at an `ollama` service that was never declared, so every ingest
# failed with nothing looking wrong (docs/15 PROD-2). Never fails startup; ~2s worst case.
EMBEDDING_PROBE_ENABLED=true

# ── OAuth (unset → login button hidden/denied) ───────────────────────────────
# [HUMAN]
GOOGLE_CLIENT_ID=
# [HUMAN]
GOOGLE_CLIENT_SECRET=
# [HUMAN]
GITHUB_CLIENT_ID=
# [HUMAN]
GITHUB_CLIENT_SECRET=
# [HUMAN] Facebook Login (Meta for Developers app). Redirect URI:
# {OAUTH_REDIRECT_BASE}/v1/auth/oauth/facebook/callback — see docs/ENV.md.
FACEBOOK_CLIENT_ID=
# [HUMAN]
FACEBOOK_CLIENT_SECRET=

# ── Self-serve signup + free trial (docs/18) ─────────────────────────────────
# Master switch. true: signing up creates one 10-day trial workspace (500 messages, one agent,
# no workflows / n8n / tool calling). false: workspaces are created by staff only, as before —
# also the kill switch if signups are being abused. The plan limits themselves live in
# apps/api/app/core/plans.py, not here.
SELF_SERVE_ENABLED=true
# New self-serve accounts allowed per client IP per 24h. 0 disables the cap.
SIGNUPS_PER_IP_PER_DAY=3
# Refuse throwaway-mailbox domains (mailinator, yopmail, …) at signup. Turn off for internal use.
BLOCK_DISPOSABLE_EMAILS=true
# Where the maintained throwaway-domain list comes from (refreshed weekly by Celery beat — run beat).
# DISPOSABLE_LIST_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf
# Record (never block on) addresses whose mail servers don't exist or belong to a throwaway service.
DISPOSABLE_MX_CHECK_ENABLED=true
DISPOSABLE_MX_TIMEOUT=2.0
# Reverse proxies whose X-Forwarded-For the API trusts to say who the visitor is (IPs / CIDRs). Without
# this every visitor behind the web app is one address and every per-IP limit is one shared bucket.
# The compose files set the Docker range for you. NEVER put a public range here.
TRUSTED_PROXIES=127.0.0.1,::1
# Failed password logins per email before that address is locked out, and for how long (seconds).
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_WINDOW=900
# Public chat messages per minute per organization on a metered plan, so one bot cannot burn a
# whole trial in seconds. Messages past it get no reply (silently) and are not counted.
ORG_CHAT_RATE_LIMIT=30
ORG_CHAT_RATE_WINDOW=60
# Where the Upgrade page sends people until paid plans exist (web app; both optional). Baked in
# at build time. WhatsApp is digits only, with country code.
NEXT_PUBLIC_UPGRADE_EMAIL=
NEXT_PUBLIC_UPGRADE_WHATSAPP=

# ── Channels (unset → channel disabled with a clear message) ─────────────────
# [HUMAN]
TELEGRAM_BOT_TOKEN=
# [HUMAN] shared by WhatsApp + Messenger + Instagram; also verifies the Data Deletion Request Callback (empty = 503)
META_APP_SECRET=
# [HUMAN]
WHATSAPP_PHONE_ID=
# [HUMAN]
WHATSAPP_TOKEN=
# [HUMAN]
WHATSAPP_VERIFY_TOKEN=
# [HUMAN] Facebook Messenger page token
META_PAGE_ACCESS_TOKEN=
# [HUMAN] the Page that receives Messenger DMs
META_PAGE_ID=
# [HUMAN] Instagram-scoped page token (instagram_manage_messages)
INSTAGRAM_PAGE_ACCESS_TOKEN=
# [HUMAN] the Instagram professional account id
INSTAGRAM_USER_ID=
# you choose; echoed back during Meta's webhook handshake
META_VERIFY_TOKEN=
# [HUMAN]
SLACK_BOT_TOKEN=
# [HUMAN]
SLACK_SIGNING_SECRET=
# [HUMAN]
DISCORD_BOT_TOKEN=
# [HUMAN]
DISCORD_PUBLIC_KEY=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678        # must match the bundled n8n's host port
# The bundled n8n's host port is `N8N_HOST_PORT` (default 5678) — but note that Compose reads
# *interpolation* variables from the shell or from `infra/.env`, NOT from this file (this file
# is passed to containers via `env_file`). So to move it:
#     cd infra && N8N_HOST_PORT=5679 docker compose up -d n8n   # or put it in infra/.env
# then set N8N_BASE_URL=http://localhost:5679 here.
# [HUMAN] n8n → Settings → API; needs the workflow
#   read/list/create/update/activate scopes
N8N_API_KEY=
# generate a random string. n8n workflows VERIFY this (docs/07). THIS FILE IS ITS ONE HOME: the api,
# worker and the n8n container all read it from here — do NOT copy it into infra/.env. Start n8n with
# `make up` (or `docker compose --env-file .env --env-file ../.env ...` from infra/) so Compose can
# interpolate it into the n8n container; started without that, n8n gets an empty secret and rejects
# every call (fail closed) — see infra/n8n/README.md "Why one file".
N8N_WEBHOOK_SIGNING_SECRET=
# Refuse to bind an n8n tool whose workflow would accept an UNSIGNED call (no verify chain — R15).
# On by default; the pasted-URL path is resolved through the n8n API, so it also needs N8N_API_KEY.
# Turn off only for a deliberately unsigned dev n8n.
N8N_REQUIRE_SIGNATURE_CHECK=true
# ── Automations (docs/26): client-visible, staff-built n8n workflows ─────────────
# HMAC secret n8n uses to sign run reports to POST /internal/automations/runs. Unset = that endpoint answers 503
# and nothing is recorded. In production `ops/n8n-setup.sh` generates it; here, generate a random string.
AUTOMATION_REPORT_SECRET=
# An n8n tool may be bound to / run a webhook only if it belongs to a registered, Active automation of the same
# org and agent. Leave true; false is for a keyless dev n8n with no registry.
N8N_REQUIRE_REGISTERED_AUTOMATION=true
# Celery beat job (every 5 min) that fills gaps in the run log from the n8n API. Needs N8N_API_KEY.
AUTOMATION_PULL_ENABLED=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=vicero

# ── Client provisioning (scripts/provision-client.mjs) ───────────────────────
# One command stands a client up: org + published agent + n8n automation + invite.
# Identical on a laptop and on a VPS — only these URLs differ.
VICERO_API_BASE_URL=http://localhost:8000
# [HUMAN] a staff login (is_staff=true). Creating an org is gated on that flag
#   server-side, so an API key cannot provision — there is no such scope.
PROVISION_STAFF_EMAIL=
# [HUMAN] that account's password
PROVISION_STAFF_PASSWORD=

# ── Email (console backend needs no setup in dev) ────────────────────────────
# console = logged to an in-memory outbox, nothing leaves the machine.
# smtp    = real delivery. Any SMTP relay works — Resend and Postmark both have a free
#           tier that suits a first handful of clients. You must also verify your sending
#           domain (SPF/DKIM records) in the provider's dashboard, or Gmail will spam-bin it.
EMAIL_BACKEND=console                     # console | smtp — set smtp once SMTP_* below are filled in
# [HUMAN] e.g. smtp.resend.com — any SMTP relay works
SMTP_HOST=
SMTP_PORT=587
# [HUMAN] from your email provider
SMTP_USER=
# [HUMAN] from your email provider
SMTP_PASS=
# [HUMAN] e.g. "Vicero <noreply@yourdomain.com>"
SMTP_FROM=

# ── Billing (optional; unset → billing disabled) ─────────────────────────────
# [HUMAN]
STRIPE_SECRET_KEY=
# [HUMAN]
STRIPE_WEBHOOK_SECRET=

# ── Observability ────────────────────────────────────────────────────────────
# optional
SENTRY_DSN=

# ── Storage & RAG ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local                     # local | s3
UPLOAD_DIR=./var/uploads                  # where ingested document files are stored (local backend)
RAG_CONTEXT_CHAR_BUDGET=8000              # max chars of retrieved context injected into a prompt
# Weight of the keyword (FTS) list in the hybrid RRF fusion; dense is fixed at 1.0.
# Conservative on purpose - see ADR-058. Re-fit with `make eval-retrieval-full` on a real KB.
RAG_RRF_FTS_WEIGHT=0.05
CELERY_TASK_ALWAYS_EAGER=false            # true = run ingestion inline (no worker); dev/testing only

# ── Docling: layout-aware document extraction (docs/14 K1) ───────────────────
# Replaces the flat pypdf text stream with real headings, reading order, table structure and
# OCR. Runs in the Celery worker, so it cannot affect chat latency.
# OFF by default; roll out per docs/14 §12. Any failure falls back to the legacy extractor,
# so a Docling outage never marks a client's upload as broken.
DOCLING_ENABLED=false
# INTERNAL address only. NEVER publish this service's port (docs/14 §9) - it accepts arbitrary
# documents and URLs, so a public port is SSRF plus resource exhaustion. Compose sets this on
# the worker automatically; set it here only when pointing at an external instance.
DOCLING_ENDPOINT=
DOCLING_DO_OCR=true                       # scanned PDFs stop being "no extractable text"
DOCLING_DO_TABLE_STRUCTURE=true           # a pricing table stops becoming word soup
DOCLING_TIMEOUT_SECONDS=120               # Docling's own guidance is 90-120s
DOCLING_CHUNK_MAX_TOKENS=512              # tokens per chunk, not characters. Sweepable (docs/14 K2-5)
# Where the heading path goes: `embed` (embedding input only) or `inline` (also into the stored
# chunk a visitor sees quoted). Leave it on `embed`: since migration 0021 the FTS index covers
# heading + content, so both modes score the same and `inline` only costs citation cleanliness.
# See ADR-065 for the measurement that forced the option and ADR-067 for the one that settled it.
DOCLING_CHUNK_HEADING_MODE=embed
# Page cap for PDF ingest (docs/14 K5-2). 0 disables. A backstop against the pathological case,
# not a product limit - a real client manual runs to a few hundred pages and must still ingest.
MAX_PDF_PAGES=800

# ── Reranking: stage 4 of retrieval (docs/13 R1, ADR-063) ────────────────────
# A cross-encoder reorders the fused candidates. OFF platform-wide AND per agent; both must be
# on. It costs a round trip BEFORE the first token, so enabling it is a latency decision.
# Any failure degrades to RRF ordering - never an error, never an empty result.
RERANK_ENABLED=false
# A /rerank endpoint. Self-hosted text-embeddings-inference is recommended: client KB text
# never leaves the deployment, and bge-reranker-v2-m3 is trained multilingual.
# Enabled with this empty warns at startup and silently falls back to RRF order.
RERANK_ENDPOINT=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=50                     # fused candidates handed to the cross-encoder
RERANK_TIMEOUT_MS=800                     # on timeout the turn proceeds on RRF ordering
# PLATFORM credential, never a client's (ADR-063). A self-hosted TEI container needs none.
# [HUMAN] optional - only for a hosted rerank API
RERANK_API_KEY=
LLM_FORCE_FAKE=false                       # true = force every chat/embedding onto the Fake provider (E2E/CI only; NEVER prod)
WEBHOOK_SWEEP_INTERVAL_SECONDS=60          # how often Celery beat re-enqueues due pending webhook deliveries

# ── Chat runtime, memory & tools ─────────────────────────────────────────────
MEMORY_WINDOW_MESSAGES=12                 # recent turns kept verbatim in the prompt
MEMORY_SUMMARY_THRESHOLD=24               # summarize older turns once a convo exceeds this many msgs
SUMMARY_PROVIDER=groq                     # provider for background summaries (small/fast, NOT the agent's)
SUMMARY_MODEL=openai/gpt-oss-20b        # summary model; falls back to the fake provider if unkeyed
# Opt-in: makes tests/test_default_model.py ask Groq itself whether the platform default models still exist
# (needs a real GROQ_API_KEY; a few tokens). Off by default so CI never depends on a vendor.
# RUN_LIVE_LLM_TESTS=1
TOOL_MAX_ITERATIONS=4                     # max tool-call iterations per turn (Phase 9)
TOOL_TIMEOUT_SECONDS=15                   # per-tool execution timeout (Phase 9)

# ── Agentic runtime & workflows (docs/17) ─────────────────────────────────────
# Platform-wide gate for the chat agentic loop / MCP tools. Off here AND per-org
# (Organization.agentic_loop_enabled) by default - both must be explicitly on.
AGENTIC_LOOP_ENABLED=false
# AgentBudget ceiling shared by the chat agentic loop AND every workflow run (a nested call
# decrements the SAME budget, never a fresh one - docs/17 §2 rule 3).
AGENTIC_MAX_STEPS=5
AGENTIC_MAX_TOOL_CALLS=5
AGENTIC_MAX_RUNTIME_S=30
AGENTIC_MAX_COST_USD=0.05
# Wider than TOOL_TIMEOUT_SECONDS: an MCP call is a subprocess spawn or a 3rd-party round trip.
MCP_TOOL_TIMEOUT_SECONDS=20
# How deep a chain of workflow sub_agent nodes may nest before AgentBudget.call_depth trips it.
WORKFLOW_MAX_CALL_DEPTH=5
# Longest a workflow delay node may schedule a real wait for (seconds, default 24h). Rejected
# loudly above this, never silently clamped.
WORKFLOW_MAX_DELAY_SECONDS=86400

# ── Guardrails (docs/11) ─────────────────────────────────────────────────────
# Hard ceiling on one visitor message; also the LLM10 unbounded-consumption control.
MAX_USER_MESSAGE_CHARS=8000
# L1 static pre-filter on the visitor's own message (direct prompt injection, OWASP LLM01).
# Off means retrieved content is defended but the person typing is not.
GUARD_INPUT_ENABLED=true
# L5 output guardrail: system-prompt leakage and persona breaks.
GUARD_OUTPUT_ENABLED=true
# Fraction of a reply's 8-grams that may also appear in the system prompt before it is
# treated as leakage and replaced.
GUARD_OUTPUT_LEAK_THRESHOLD=0.35
# L5 PII egress: redact emails/phones from a reply unless the org has allowlisted them in
# Organization.public_contacts. Secret redaction runs regardless of this flag.
GUARD_PII_EGRESS_ENABLED=true
# Regions used to read phone numbers written WITHOUT a country code, most likely first.
# Numbers written with an explicit +CC are found regardless of this list.
GUARD_PII_PHONE_REGIONS=IN,US,GB
# Street-address detection is much less precise than email/phone ("12 Month Plan" reads as a
# house number), so it is counted in a document's pii_flags but not redacted from replies.
GUARD_PII_REDACT_ADDRESSES=false

# ── L2 injection classifier (docs/11 §4-L2, Phase C) ─────────────────────────
# Catches what the L1 regexes structurally cannot: paraphrase, and every language other than
# English. Runs on the PLATFORM GROQ_API_KEY, never a client's key (ADR-055) - so it keeps
# working for an org running its agent on Mistral/DeepSeek/xAI/etc.
GUARD_INJECTION_ENABLED=true
# Model id, never inline: Groq deprecated llama-guard-4-12b in Feb 2026.
# Check https://console.groq.com/docs/deprecations before changing this.
GUARD_INJECTION_MODEL=meta-llama/llama-prompt-guard-2-86m
# Measured separation is huge (benign < 0.005, attacks > 0.998), so 0.5 sits in empty space.
GUARD_INJECTION_THRESHOLD=0.5
# On timeout the turn proceeds UNGUARDED (fail open) with a loud log and a metric.
GUARD_INJECTION_TIMEOUT_MS=300
GUARD_INJECTION_CACHE_TTL_SECONDS=3600

# ── L3 policy & distress classifier (docs/11 §4-L3, Phase E) ─────────────────
# Grades each customer message against the markdown in apps/api/app/chat/policies/ (editable,
# hot-reloadable). Drives the inbox "Needs attention" queue. Runs on the PLATFORM key.
# NOTE: on `elevated` the bot KEEPS ANSWERING while a human is alerted. Only `crisis`
# suppresses the reply, and it emits a fixed written holding message - never silence.
GUARD_POLICY_ENABLED=true
GUARD_POLICY_MODEL=openai/gpt-oss-safeguard-20b
GUARD_POLICY_TIMEOUT_MS=1200
# Turn distress grading off entirely for a client who has not agreed to watch the queue.
GUARD_DISTRESS_ENABLED=true

# ── Web access (docs/11 §L7, Phase G) ────────────────────────────────────────
# OFF by default and off per-agent too. Enabling it lets an agent reach the open internet on a
# customer's behalf, which is a per-client decision, not a platform default.
# The per-agent domain allowlist (features.web_search_allowed_domains) ships EMPTY, and empty
# means NOTHING is searchable - not "search anything". A support agent that can search the
# whole web will confidently quote a competitor's pricing.
WEB_SEARCH_ENABLED=false
# [HUMAN] Tavily (or any endpoint returning {results:[{url,title,content}]})
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MONTHLY_QUOTA=1000

# ── Private admin area (/vault) ──────────────────────────────────────────────────
# A separate sign-in, entirely independent of Vicero accounts, that shows the internal
# architecture and the real values of every setting in this file (masked until revealed).
# It stays OFF until all three are set. Run `make vault-password` to generate the hash and
# the session secret — it never prints or stores the password itself.
# [HUMAN] Comma-separated allow-list. Only these addresses may sign in.
VAULT_ADMIN_EMAILS=
# [HUMAN] Output of `make vault-password`. A hash, never the password.
VAULT_PASSWORD_HASH=
# [HUMAN] Random, 32+ characters. Signs the session cookie. Changing it signs the admin out.
VAULT_SESSION_SECRET=
# Optional path to a KEY=value file (e.g. a read-only mount of the root .env) to read values
# from when they are not in the web process's own environment. The dev compose already gives
# the web container the whole root .env; the production one gives it two variables only.
VAULT_ENV_FILE=

# ── Test-only switches (NEVER set these in production) ───────────────────────
# Lets a non-staff user create an organization. Production is staff-only: Vicero is
# provisioned per client, and with this on anyone who can reach /signup can hand themselves
# a workspace. The test suites need it because they bootstrap a tenant per test via the API.
ALLOW_SELF_SERVE_ORGS=false

# ── Multi-currency pricing display (docs/22 §3, ADR-106) ─────────────────────
# Country header -> display currency on GET /v1/billing/plans. DISPLAY ONLY: never decides what is
# charged or what plan an org gets. Leave false in dev. Set true in prod ONLY when the API is
# reachable solely through a proxy that sets one of the headers below (otherwise it is spoofable).
TRUST_GEO_HEADERS=false
# Comma-separated, checked in order; first non-empty known country wins.
GEO_COUNTRY_HEADERS=CF-IPCountry,X-Vercel-IP-Country,CloudFront-Viewer-Country,X-Country-Code
# Offline IP->country database (no key needed): `python scripts/fetch_geoip_db.py` from apps/api, then set
# this to the file it wrote. Used only when no trusted header gave a country - works with plain Caddy.
# Display only. Empty = off. Needs TRUSTED_PROXIES set so the visitor's X-Forwarded-For is believed.
GEOIP_DB_PATH=
